FROM docker.io/library/rust:1-bookworm AS builder

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY testbed/Cargo.toml testbed/Cargo.toml
COPY src src

RUN cargo build --release -p avena-net --bin avena-net

FROM docker.io/library/golang:1.24-bookworm AS wireguard-go-builder

WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends git make \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/WireGuard/wireguard-go.git . \
    && make

FROM registry.fedoraproject.org/fedora:43

RUN dnf install -y --setopt=install_weak_deps=False \
        babeld \
        ca-certificates \
        iproute \
        wireguard-tools \
    && dnf clean all \
    && rm -rf /var/cache/dnf

COPY --from=builder /src/target/release/avena-net /usr/local/bin/avena-net
COPY --from=wireguard-go-builder /src/wireguard-go /usr/local/bin/wireguard-go

ENTRYPOINT ["/usr/local/bin/avena-net"]
CMD ["/etc/avena/avena-net.toml"]
